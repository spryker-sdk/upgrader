<?xml version="1.0"?>
<ruleset name="SprykerLibrary">
    <description>
        Spryker Coding Standard.

        Extends main Spryker Coding Standard.
        All sniffs in ./Sniffs will be auto loaded
    </description>

    <arg name="colors"/>
    <arg name="tab-width" value="4"/>
    <arg value="nps"/>

    <exclude-pattern>tests/data/</exclude-pattern>

    <file>src/</file>
    <file>tests/</file>

    <rule ref="vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml">
        <!-- excluded on purpose: SprykerStrict pulls in the full Spryker/ruleset.xml,
             which requires docblocks (DocBlock/DocBlockConst/InlineDocBlock/DocBlockReturnVoid),
             directly contradicting SprykerStrict.TypeHints.*.UselessAnnotation, which forbids
             them. Without this exclude, phpcbf oscillates forever on typed methods/properties. -->
        <exclude name="Spryker.Commenting.DocBlock"/>
        <exclude name="Spryker.Commenting.DocBlockConst"/>
        <exclude name="Spryker.Commenting.InlineDocBlock"/>
        <exclude name="Spryker.Commenting.DocBlockReturnVoid"/>
    </rule>

    <rule ref="Spryker.PHP.DeclareStrictTypesAfterFileDoc">
        <properties>
            <property name="strictTypesMandatory" value="true"/>
        </properties>
    </rule>
</ruleset>
